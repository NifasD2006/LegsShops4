<Window x:Class="Safin41.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Safin41"
        mc:Ignorable="d"
        Title="Сафин" Height="450" Width="800" FontFamily="Comic Sans MS" Icon="/res/icon.ico" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" ></RowDefinition>
            <RowDefinition Height="300" ></RowDefinition>
            <RowDefinition Height="50" ></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" HorizontalAlignment="Center" Text="411 размер" FontSize="50" ></TextBlock>
        <Button Grid.Row="0" HorizontalAlignment="Right" Content="Выход" Name="BackBtn" Click="BackBtn_Click" ></Button>
        <Image Grid.Row="0" Source="/res/logo.png" HorizontalAlignment="Left" />
        <Frame Grid.Row="1" Name="MainFrame" ContentRendered="MainFrame_ContentRendered" NavigationUIVisibility="Hidden" ></Frame>
    </Grid>
</Window>
